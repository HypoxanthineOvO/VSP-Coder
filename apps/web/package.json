{
  "name": "@vsp-coder/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "pretypecheck": "npm run build -w @vsp-coder/protocol",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --host 0.0.0.0 --port ${WEB_PORT:-5173}",
    "test": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "@vsp-coder/protocol": "0.1.0",
    "vite": "^7.2.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "lucide-react": "^0.561.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
