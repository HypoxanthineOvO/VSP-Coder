{
  "name": "vsp-coder",
  "version": "0.2.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vsp-coder/server & npm run dev -w @vsp-coder/web",
    "build": "npm run build -ws",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "start": "npm run start -w @vsp-coder/server",
    "qa": "npm run test && npm run build",
    "deploy:local": "node scripts/deploy-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  }
}
